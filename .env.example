# Local development database.
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5432

# Keep this URL in sync when changing the credentials, database, or port above.
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/app

# Required: generate once with `openssl rand -hex 32` and put the result in .env.
# Keep this key private and stable; it decrypts the password copies shown in the user list.
PASSWORD_ENCRYPTION_KEY=
